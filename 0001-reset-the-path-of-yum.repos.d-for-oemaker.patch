+    yum list --setopt=reposdir=yum.repos.d --installroot="${BUILD}"/tmp --available | awk '{print $1}' | grep -E "debuginfo|debugsource" > ava_debug_lst
     parse_rpmlist_xml "everything_debug_exclude"
