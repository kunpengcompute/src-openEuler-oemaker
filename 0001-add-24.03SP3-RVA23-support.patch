 .../config_files/riscv64/grub2-efi.cfg        | 17 ++++---
 isomaker/80-openeuler/efi.tmpl                |  1 +
 isomaker/img_repo.sh                          | 11 ++--
 isomaker/iso.sh                               | 50 ++++++++++++++-----
 4 files changed, 54 insertions(+), 25 deletions(-)

diff --git a/isomaker/80-openeuler/config_files/riscv64/grub2-efi.cfg b/isomaker/80-openeuler/config_files/riscv64/grub2-efi.cfg
index cc407f6..ca2bb5b 100644
--- a/isomaker/80-openeuler/config_files/riscv64/grub2-efi.cfg
+++ b/isomaker/80-openeuler/config_files/riscv64/grub2-efi.cfg
@@ -26,21 +26,22 @@ set timeout=60
 search --no-floppy --set=root -l '@ISOLABEL@'
 
 ### BEGIN /etc/grub.d/10_linux ###
-menuentry 'Install @PRODUCT@ @VERSION@' --class red --class gnu-linux --class gnu --class os {
-    linux @KERNELPATH@ @ROOT@ ro inst.geoloc=0 systemd.default_timeout_start_sec=600 highres=off earlycon
+menuentry 'Install @PRODUCT@ @VERSION@ @RELEASE@' --class red --class gnu-linux --class gnu --class os {
+    linux @KERNELPATH@ @ROOT@ ro inst.geoloc=0 systemd.default_timeout_start_sec=600 highres=off earlycon inst.xtimeout=600
     initrd @INITRDPATH@
 }
-menuentry 'Test this media & install @PRODUCT@ @VERSION@' --class red --class gnu-linux --class gnu --class os {
-    linux @KERNELPATH@ @ROOT@ rd.live.check inst.geoloc=0 systemd.default_timeout_start_sec=600 highres=off earlycon
+menuentry 'Test this media & install @PRODUCT@ @VERSION@ @RELEASE@' --class red --class gnu-linux --class gnu --class os {
+    linux @KERNELPATH@ @ROOT@ rd.live.check inst.geoloc=0 systemd.default_timeout_start_sec=600 highres=off earlycon inst.xtimeout=600
     initrd @INITRDPATH@
 }
 submenu 'Troubleshooting -->' {
-    menuentry 'Install @PRODUCT@ @VERSION@ in basic graphics mode' --class red --class gnu-linux --class gnu --class os {
-            linux @KERNELPATH@ @ROOT@ nomodeset inst.geoloc=0 systemd.default_timeout_start_sec=600 highres=off earlycon
+    menuentry 'Install @PRODUCT@ @VERSION@ @RELEASE@ in basic graphics mode' --class red --class gnu-linux --class gnu --class os {
+            linux @KERNELPATH@ @ROOT@ nomodeset inst.geoloc=0 systemd.default_timeout_start_sec=600 highres=off earlycon inst.xtimeout=600
             initrd @INITRDPATH@
     }
     menuentry 'Rescue the @PRODUCT@ system' --class red --class gnu-linux --class gnu --class os {
-            linux @KERNELPATH@ @ROOT@ rescue systemd.default_timeout_start_sec=600 highres=off earlycon
+            linux @KERNELPATH@ @ROOT@ rescue systemd.default_timeout_start_sec=600 highres=off earlycon inst.xtimeout=600
+>>>>>>> add 24.03SP3 RVA23 support
             initrd @INITRDPATH@
     }
-}
\ No newline at end of file
+}
diff --git a/isomaker/80-openeuler/efi.tmpl b/isomaker/80-openeuler/efi.tmpl
index c9cbc33..0a8989d 100644
--- a/isomaker/80-openeuler/efi.tmpl
+++ b/isomaker/80-openeuler/efi.tmpl
@@ -48,6 +48,7 @@ ${make_efiboot("images/efiboot.img")}
     install ${configdir}/grub2-efi.cfg ${eficonf}
     replace @PRODUCT@ '${product.name}' ${eficonf}
     replace @VERSION@ ${product.version} ${eficonf}
+    replace @RELEASE@ ${product.release} ${eficonf}
     replace @KERNELNAME@ vmlinuz ${eficonf}
     replace @KERNELPATH@ /${kdir}/vmlinuz ${eficonf}
     replace @INITRDPATH@ /${kdir}/initrd.img ${eficonf}
diff --git a/isomaker/img_repo.sh b/isomaker/img_repo.sh
index 530f3c7..5a5884d 100755
--- a/isomaker/img_repo.sh
+++ b/isomaker/img_repo.sh
@@ -30,11 +30,12 @@ function create_install_img()
     done
 
     echo "${tmprep}" > yumrepo.file
-    if [ -n "${RELEASE}" ];then
-        vertmp="${VERSION}-${RELEASE}"
-    else
-        vertmp=${VERSION}
-    fi
+    #if [ -n "${RELEASE}" ];then
+    #    vertmp="${VERSION}-${RELEASE}"
+    #else
+    #    vertmp=${VERSION}
+    #fi
+    vertmp=${VERSION}
     set +e
     lorax --isfinal -p "${PRODUCT}" -v "${vertmp}" -r "${RELEASE}" -t "${VARIANT}" --sharedir 80-openeuler --rootfs-size=4 --buildarch="$ARCH" $(cat yumrepo.file) --nomacboot --noupgrade "${BUILD}"/iso > lorax.logfile 2>&1
 
